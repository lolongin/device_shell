{
  "name": "odyterm-desktop",
  "version": "0.1.0",
  "description": "OdyTerm Electron desktop client.",
  "author": "OdyTerm Contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:backend": "powershell -ExecutionPolicy Bypass -File scripts/build-python-backend.ps1",
    "dist": "npm run build && npm run build:backend && electron-builder --config electron-builder.yml --publish never",
    "smoke:release": "powershell -ExecutionPolicy Bypass -File scripts/validate-release.ps1",
    "smoke:clean-runtime": "powershell -ExecutionPolicy Bypass -File scripts/validate-clean-runtime.ps1",
    "smoke:ui-parity": "npm run build && node scripts/smoke-ui-parity.mjs",
    "smoke:soak": "powershell -ExecutionPolicy Bypass -File scripts/soak-backend.ps1",
    "smoke:app-soak": "powershell -ExecutionPolicy Bypass -File scripts/soak-packaged-app.ps1",
    "soak:app": "powershell -ExecutionPolicy Bypass -File scripts/soak-packaged-app.ps1 -DurationMinutes 480 -PauseSeconds 5",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-vue-next": "^1.0.0",
    "node-pty": "1.1.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.9"
  }
}
